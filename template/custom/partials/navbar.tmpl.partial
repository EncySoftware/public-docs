<nav id="autocollapse" class="navbar navbar-inverse ng-scope" role="navigation">
  <div class="container">
    <div class="navbar-header">
      <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#navbar">
        <span class="sr-only">탐색 메뉴 전환</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      {{>partials/logo}}
      <div class="documentation-heading">
        {{#_nav}}
          {{>partials/navbar-li}}
        {{/_nav}}
        {{#_documentationVersion}}
        <span id="documentation-version" aria-label="문서 버전 v{{_documentationVersion}}">v{{_documentationVersion}}</span>
        {{/_documentationVersion}}
      </div>
    </div>
    <div class="collapse navbar-collapse" id="navbar">
      <form class="navbar-form navbar-right" role="search" id="search">
        <div class="form-group">
          <input type="text" class="form-control" id="search-query" placeholder="검색" autocomplete="off">
        </div>
      </form>
    </div>
  </div>
</nav>
