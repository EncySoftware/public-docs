{
  "build": {
    "content": [
      {
        "files": [
          "src/**/*.{md,yml}",
          "pdf/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "src/images/**",
          "src/attachments/**",
          "src/assets/**"
        ]
      }
    ],
    "dest": "out/pdf",
    "template": [
      "default",
      "modern"
    ]
  }
}
