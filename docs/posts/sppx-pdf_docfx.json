{
  "build": {
    "content": [
      { "src": "sppx", "files": [ "**/*.{md,yml}" ], "exclude": [ "**/_pdf/**", "**/_site/**", "**/obj/**" ], "dest": "sppx" },
      { "src": "cldata", "files": [ "**/*.{md,yml}" ], "exclude": [ "**/_pdf/**", "**/_site/**" ], "dest": "cldata" }
    ],
    "resource": [
      { "src": "sppx", "files": [ "images/**" ], "dest": "sppx" }
    ],
    "dest": "sppx/_pdf",
    "template": [ "default", "modern" ]
  }
}
