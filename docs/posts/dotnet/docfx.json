{
  "build": {
    "content": [
      { "src": "src", "files": [ "**/*.{md,yml}" ] },
      { "src": "../cldata", "files": [ "**/*.{md,yml}" ], "dest": "cldata" }
    ],
    "resource": [
      { "src": "src", "files": [ "images/**", "attachments/**" ] },
      { "src": "../sppx/src", "files": [ "images/**" ], "dest": "sppx/src" }
    ],
    "dest": "out/html",
    "template": [ "statictoc" ],
    "markdownEngineName": "markdig"
  }
}
