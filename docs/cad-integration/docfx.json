{
  "build": {
    "content": [
      {
        "src": "src",
        "files": [
          "**/*.{md,yml}"
        ]
      }
    ],
    "resource": [
      {
        "src": "src",
        "files": [
          "images/**",
          "attachments/**"
        ]
      }
    ],
    "dest": "out/html",
    "globalMetadata": {
      "_appName": "Creating a CAM-system Add-in",
      "_appTitle": "Creating a CAM-system Add-in",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "template": [
      "default",
      "modern"
    ],
    "markdownEngineName": "markdig"
  }
}
